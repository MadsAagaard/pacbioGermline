/*
 * =============================================================================
 * conf/backgroundPerSample.config
 * =============================================================================
 *
 * Config overlay for backgroundPerSample.nf. Pass it explicitly:
 *
 *   -c conf/backgroundPerSample.config
 *
 * NOT auto-loaded and NOT optional: backgroundPerSample.nf aborts at startup if
 * the publish targets still resolve inside the clinical tree.
 *
 * WHY -c AND NOT A PROFILE
 * ------------------------
 * This file overrides params.outBase, which nextflowLRS.config defines as a
 * closure. Config precedence puts -c files above the project config, so the
 * override reliably wins. A profile in an includeConfig'd file would depend on
 * include ordering inside a chain that lives partly outside the repo
 * (/data/configs/nextflowLRS.config) — too fragile for the one setting that
 * stands between a background batch and the clinical tree.
 *
 * WHAT IT DOES
 * ------------
 * Replaces the publishDir set on the two TRGT processes so their output lands
 * in ONE flat directory per catalog instead of per-sample clinical paths.
 * dnaModules.nf and PREPROCESS.nf are imported COMPLETELY UNCHANGED — a
 * clinical adotto call and a background adotto call run identical code and
 * differ only in destination.
 * =============================================================================
 */

params {

    // ---- Pool location -----------------------------------------------------
    // Declared here rather than required on the command line, on purpose.
    // There is only one pool, so there is nothing to decide per run — and a
    // typo'd --bgRoot does not error: skip-if-done looks in the empty wrong
    // place, finds nothing, and realigns the entire cohort into a second pool
    // nobody knows about. The way to not typo a path is to not type it.
    bgRoot = '/lnx01_data3/storage/pacBioLRS/background'

    // ---- Required on the command line --------------------------------------
    bgSheet = null

    // ---- Optional ----------------------------------------------------------
    force              = false   // re-run samples already in the pool
    initPool           = false   // permit creating a pool that does not exist
    batch              = null    // label for this run's reports
}

// The flat pool. One directory per catalog, every sample together — this is
// what the LPS toolkit reads.
params.bgPool = "${params.bgRoot}/repeatExpansions/background"

// Only names runInfo/ and the log header. NOT a cohort version: the
// yymmdd+letter stamp is applied downstream, to a hand-picked subset.
params.batchTag = params.batch ?: new Date().format('yyMMdd_HHmmss')


// =============================================================================
// OUTPUT REDIRECTION
// =============================================================================
// The publishDir overrides below are what actually place the output. These two
// params are a safety net for anything else in the DAG that publishes.
//
// _unusedPerSample is named to be conspicuous: a background run should write
// nothing there. If files appear, a process publishDir was not overridden (or
// config publishDir appends rather than replaces — see the note below), and it
// is immediately visible instead of silently duplicating the pool.
//
// The layout is flat and keyed on meta.id. A background meta carries no
// rekv/testlist/groupKey, so the clinical 'auto' layout would interpolate nulls
// into "null_null_<npn>_null_AllAndHifi" — a malformed path rather than an
// error. Overriding the closure removes the possibility.

params.outBase       = { meta -> "${params.bgRoot}/_unusedPerSample/${meta.id}" }
params.lrsStorage    = "${params.bgRoot}/_unusedStorage"
params.outputDirBase = "${params.bgRoot}"
params.multiqcKey    = { meta -> meta.id }


// =============================================================================
// REPORTING
// =============================================================================
// nextflowLRS.config keys these on ${outputDirBase}/runInfo/<date>_<ssBase>,
// and ssBase is 'NoSampleSheet' here. Two concurrent batches would collide.

def bgReports = "${params.bgRoot}/runInfo/${params.batchTag}"

timeline { enabled = true; file = "${bgReports}/timeline.html"; overwrite = true }
report   { enabled = true; file = "${bgReports}/report.html";   overwrite = true }
dag      { enabled = true; file = "${bgReports}/dag.html";      overwrite = true }
trace    {
    enabled   = true
    file      = "${bgReports}/trace.txt"
    overwrite = true
    fields    = 'task_id,hash,name,tag,status,exit,attempt,realtime,%cpu,peak_rss,read_bytes,write_bytes,workdir'
}


// =============================================================================
// WORK DIRECTORY
// =============================================================================
// The slurm profile derives workDir from ssBaseName, which is 'NoSampleSheet'
// here, so two concurrent batches would share one workDir.
//
// This is where the ~90 GB/sample alignments live. Run in batches of 20-40 and
// clean between them:  nextflow clean -f -before <runName>

workDir = "/nfs_fast_b/data/nextflowSlurmWork/${System.getenv('USER') ?: 'unknown'}/bg_${params.batchTag}"


// =============================================================================
// ERROR STRATEGY
// =============================================================================
// nextflowLRS.config computes `defaultErrorStrategy` from params.errorMode at
// parse time, so setting params.errorMode from a -c file would arrive too late
// to affect the already-resolved directive. Set errorStrategy directly.
//
// 'ignore' is safe here because the pool is a set of independent per-sample
// artifacts: a failed sample is simply absent, shows up in inputs.tsv as not
// having produced output, and is picked up by re-running or -resume.

def transientExits = [104, 130, 134, 137, 138, 139, 140, 143, 247, 250, 251]

process {

    errorStrategy = { task.attempt <= 2 && task.exitStatus in transientExits ? 'retry' : 'ignore' }
    maxRetries    = 2

    // =========================================================================
    // TRGT v5 — flat pool output
    // =========================================================================
    // Setting publishDir in config supersedes the directive in the process body,
    // so this REPLACES all four publishDir blocks in trgt5_all_adotto — both the
    // clinical per-sample ones and the lrsStorage ones. dnaModules.nf is not
    // touched.
    //
    // VERIFY ON THE FIRST RUN: if <bgRoot>/_unusedPerSample/ contains anything
    // afterwards, config publishDir appended rather than replaced. Nothing lands
    // outside bgRoot either way (outBase is redirected above), so the failure
    // mode is duplicate files in an obviously-named directory, not clinical
    // contamination.
    //
    // Patterns are catalog-specific rather than generic *.sorted.vcf.*, so
    // adotto and trexplorer output cannot land in each other's directory:
    //   <npn>.<genome>.<strTag>.trgt5.adotto.sorted.vcf.gz{,.tbi}
    //   <npn>.<genome>.<strTag>.trgt5.adotto.LPS.txt
    //
    // No spanning-BAM publishDir: both processes run --disable-bam-output, so
    // no BAM exists to publish. Only the VCF (+tbi) and the LPS table leave the
    // task.

    // Resources set here override the process 'intermediate' label. TRGT v5 is
    // threaded (--threads ${task.cpus}), so cpus is a real knob; tune against
    // the first batch's trace.txt rather than assuming.
    withName: 'trgt5_all_adotto' {
        cpus   = 32
        memory = '48 GB'
        time   = '72h'
        publishDir = [
            [ path: "${params.bgPool}/adotto",
              mode: 'copy', pattern: '*.trgt5.adotto.sorted.vcf.*', overwrite: true ],
            [ path: "${params.bgPool}/adotto_LPS",
              mode: 'copy', pattern: '*.trgt5.adotto.LPS.txt', overwrite: true ],
        ]
    }

    withName: 'trgt5_all_TRexplorer' {
        cpus   = 32
        memory = '48 GB'
        time   = '72h'
        publishDir = [
            [ path: "${params.bgPool}/trexplorer",
              mode: 'copy', pattern: '*.trgt5.trexplorer.sorted.vcf.*', overwrite: true ],
            [ path: "${params.bgPool}/trexplorer_LPS",
              mode: 'copy', pattern: '*.trgt5.trexplorer.LPS.txt', overwrite: true ],
        ]
    }

    // =========================================================================
    // Alignments — not published
    // =========================================================================
    // ~700 samples x ~90 GB of HiFi BAM is not storable, and nothing downstream
    // needs the alignment once both catalogs have read it.
    //
    // CONSEQUENCE: a third catalog later means realigning the whole pool. Add it
    // to the workflow BEFORE populating the pool, not afterwards.

    withName: 'pbmm2_align_failedOnly' {
        cpus   = 32
        memory = '32 GB'
        time   = '24h'
        publishDir = [ enabled: false ]
    }

    withName: 'pbmm2_align_hifi' {
        cpus   = 64
        memory = '64 GB'
        time   = '72h'
    }

    // =========================================================================
    // Bookkeeping — nothing published; inputs.tsv already records the inputs
    // =========================================================================

    withName: 'create_fofn' {
        executor = 'local'
        cpus     = 2
        memory   = '4 GB'
        scratch  = false
        publishDir = [ enabled: false ]
    }

    withName: 'inputFiles_symlinks_ubam' {
        executor = 'local'
        cpus     = 2
        memory   = '4 GB'
        scratch  = false
        publishDir = [ enabled: false ]
    }
}
