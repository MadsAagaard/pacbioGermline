/*
 * =============================================================================
 * pacbioGermline/conf/germlineRNA.config — germline RNA run (rna.nf) only
 * =============================================================================
 * Included by nextflow.config only when --rnaSS is given, AFTER conf/germline.config
 * and BEFORE finalize.config, so finalize derives the report paths and the slurm
 * workDir from the values set here. A germline DNA run never reads this file.
 *
 * Status: TEST PHASE, not clinical. Output goes to a separate RNAdata tree and
 * nothing is written to the production storage area (/lnx01_data3/storage/...).
 *
 * Requires lrsShared v2 or later (RNA conda envs, RNA tool defaults, RNA
 * scripts). nextflow.config pins v2 for --rnaSS runs.
 * =============================================================================
 */

def sharedMajor = (params.lrsSharedVersion ?: 'v0').toString().replaceFirst(/^v/, '') as int
if (sharedMajor < 2) {
    throw new IllegalStateException(
        "germline RNA needs lrsShared v2 or later; ${params.lrsSharedDir} is " +
        "${params.lrsSharedVersion ?: 'v1 (no lrsSharedVersion key)'}. " +
        "Use --lrsSharedDir /data/configs/lrsShared/v2")
}


// =============================================================================
// 1. GERMLINE RNA CLI FLAGS
// =============================================================================
params {
    // ---- input ----------------------------------------------------------------
    // RNA uBAMs are found under params.dataArchiveRNA (lrsShared v2) with
    // **/*.lima.*.bam; --inputRNA searches another folder instead.
    inputRNA            = null

    // ---- germline DNA lookup (rna.nf, at launch) --------------------------------
    // Order: 1) phasedVcf column in --rnaSS, 2) central store, 3) case folders.
    // Each step must give exactly one file with its .tbi, or the run stops.
    // 2) <germlineVcfStore>/<readSet>/deepVariant/vcfs/<dnaNPN>.<genomeVersion>.*.hiphase.deepvariant.vcf.gz
    germlineVcfStore    = "${params.lrsStorageRoot}/${params.genome}"
    germlineReadSets    = ['AllAndHifi', 'hifiReads']
    // 3) <germlineCaseRoot>/<year>/perSampleAnalysis/*/*_<dnaNPN>_*/SNV_and_INDELs/<same file name>
    germlineCaseRoot    = "/lnx01_data3/pacBioAnalyzedSamples/${params.genome}"

    // ---- RNA vs DNA identity check (before haplotagging) -------------------------
    // At DNA hom-alt SNPs with RNA depth >= minDepth, a site is discordant when the
    // RNA ref-allele fraction is > maxRefFrac. FAIL when discordant sites
    // > maxDiscordant of tested sites, or fewer than minSites were tested.
    // Defaults are starting values (inferred, not calibrated): expect < 0.05 for
    // the same person and roughly 0.3-0.6 for another person. Calibrate on the
    // first runs. FAIL stops haplotagging and splicing for that sample only.
    rnaIdentityCheck         = true
    rnaIdentityMinDepth      = 10
    rnaIdentityMaxRefFrac    = 0.2
    rnaIdentityMinSites      = 100
    rnaIdentityMaxDiscordant = 0.10
    rnaIdentityMinMapQ       = 20
    rnaIdentityMinBaseQ      = 10
}


// =============================================================================
// 2. OUTPUT, STORAGE, RUN NAMING
// =============================================================================
// Default: /lnx01_data3/pacBioAnalyzedSamples/<genome>/<year>/RNAdata
// --outdir is used as given (no read-set suffix, unlike germline DNA).
params.outputDirBase = params.outdir
    ? "${params.outdir}"
    : "/lnx01_data3/pacBioAnalyzedSamples/${params.genome}/${params.yearStamp}/RNAdata"

// One folder per pair: <rnaNPN>_<dnaNPN>, or <rnaNPN>_noDNA (set in rna.nf as meta.outName).
params.outBase    = { meta -> "${params.outputDirBase}/${meta.outName}" }
params.multiqcKey = { meta -> meta.id }

// Test phase: everything the RNA modules send to "storage" (splice JSON for the
// recurrence store, isoCall profiles) stays inside this output tree.
params.lrsStorage = "${params.outputDirBase}/storage"

// Run name for runInfo/, reports and the slurm workDir (finalize.config).
params.ssBase = new File(params.rnaSS.toString()).name.replaceFirst(/\.(txt|tsv|csv)$/, '')

// Test phase: one bad sample must not stop the others. Requires the
// FAILED_TASKS manifest, which rna.nf writes in workflow.onComplete.
params.errorMode = 'cohort'


// =============================================================================
// 3. OVERRIDES OF SHARED KEYS (lrsShared v2)
// =============================================================================
// spliceRecurrenceDb: the shared store is built from tumour RNA. Blood has other
// tissue-specific isoforms, so blood RNA must not be filtered against it.
// A blood store comes later, once blood samples have accumulated.
params.spliceRecurrenceDb = null


// =============================================================================
// 4. GENE LISTS — first test: PanelApp epilepsy + mitochondrial, merged (v1)
// =============================================================================
// panelapp_epilepsy_mito.v1.txt            1294 unique symbols, as given by PanelApp
// panelapp_epilepsy_mito.v1.aliases.tsv    legacy <TAB> current symbol (47 lines)
// panelapp_epilepsy_mito.v1.currentSymbols.txt
//                                          the same genes with the aliases applied
// Splicing: lrs_splice resolves each symbol in the GTF, else through the alias
//   file. rna.nf checks this at launch and stops if a symbol is not resolved.
// Fusion: the list only fills the *.INHOUSE.txt grep and the in_panel tag of
//   fusion_annotate (pbfusion calls all fusions). Both match the GTF symbol
//   directly, so they get the current-symbol list.
// --inhouseSplicingGenelist null on the command line runs splicing genome-wide.
def germlineGenelists = "${params.refFilesDirLegacy}/databases/genelists/germlineRNA"

params {
    inhouseSplicingGenelist = "${germlineGenelists}/panelapp_epilepsy_mito.v1.txt"
    spliceGeneAliases       = "${germlineGenelists}/panelapp_epilepsy_mito.v1.aliases.tsv"
    inhouseFusionGenelist   = "${germlineGenelists}/panelapp_epilepsy_mito.v1.currentSymbols.txt"
    fusionGeneList          = "${germlineGenelists}/panelapp_epilepsy_mito.v1.currentSymbols.txt"
}


// =============================================================================
// 5. PROCESS OVERRIDES
// =============================================================================
// lrs_splice keeps every read of a panel gene in memory. This panel includes the
// 37 MT- genes, which carry a large share of blood RNA reads, so 64 GB for the
// first runs. Lower it once peak_rss of lrs_splice is known (trace file).
def spliceMemory = '64 GB'

process {
    withName: 'lrs_splice' { memory = spliceMemory }
}

profiles {
    slurm {
        process {
            withName: 'lrs_splice'       { memory = spliceMemory; time = '24h' }
            withName: 'rna_dna_identity' { cpus = 2; memory = '8 GB'; time = '12h' }
        }
    }
}
