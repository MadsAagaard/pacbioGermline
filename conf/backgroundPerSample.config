
params {

    // ---- Pool location -----------------------------------------------------

    bgRoot = '/lnx01_data3/storage/pacBioLRS/background'

    // ---- Required on the command line --------------------------------------
    bgSheet = null

    // ---- Optional ----------------------------------------------------------
    force    = false   // re-run samples already in the pool
    initPool = false   // permit creating a pool that does not exist
    batch    = null    // label for this run's reports
}

params.bgPool = "${params.bgRoot}/repeatExpansions/background"

params.batchTag = params.batch ?: new Date().format('yyMMdd_HHmmss')


// =============================================================================
// PROFILE — only active with -profile background
// =============================================================================

profiles {

    background {

        params.outBase       = { meta -> "${params.bgRoot}/_unusedPerSample/${meta.id}" }
        params.lrsStorage    = "${params.bgRoot}/_unusedStorage"
        params.outputDirBase = "${params.bgRoot}"
        params.multiqcKey    = { meta -> meta.id }


        workDir = "/nfs_fast_b/data/nextflowSlurmWork/${System.getenv('USER') ?: 'unknown'}/bg_${params.batchTag}"

        timeline { enabled = true; file = "${params.bgRoot}/runInfo/${params.batchTag}/timeline.html"; overwrite = true }
        report   { enabled = true; file = "${params.bgRoot}/runInfo/${params.batchTag}/report.html";   overwrite = true }
        dag      { enabled = true; file = "${params.bgRoot}/runInfo/${params.batchTag}/dag.html";      overwrite = true }
        trace {
            enabled   = true
            file      = "${params.bgRoot}/runInfo/${params.batchTag}/trace.txt"
            overwrite = true
            fields    = 'task_id,hash,name,tag,status,exit,attempt,realtime,%cpu,peak_rss,read_bytes,write_bytes,workdir'
        }

        // ---------------------------------------------------------------------
        // PROCESS
        // ---------------------------------------------------------------------
        process {

            errorStrategy = { task.attempt <= 2 && task.exitStatus in [104,130,134,137,138,139,140,143,247,250,251] ? 'retry' : 'ignore' }
            maxRetries    = 2

            withName: 'trgt5_all_adotto' {
                cpus   = 32
                memory = '48 GB'
                time   = '72h'
                publishDir = [
                    [ path: { "${params.bgPool}/adotto" },
                      mode: 'copy', pattern: '*.trgt5.adotto.sorted.vcf.*', overwrite: true ],
                    [ path: { "${params.bgPool}/adotto_LPS" },
                      mode: 'copy', pattern: '*.trgt5.adotto.LPS.txt', overwrite: true ],
                ]
            }

            withName: 'trgt5_all_TRexplorer' {
                cpus   = 32
                memory = '48 GB'
                time   = '72h'
                publishDir = [
                    [ path: { "${params.bgPool}/trexplorer" },
                      mode: 'copy', pattern: '*.trgt5.trexplorer.sorted.vcf.*', overwrite: true ],
                    [ path: { "${params.bgPool}/trexplorer_LPS" },
                      mode: 'copy', pattern: '*.trgt5.trexplorer.LPS.txt', overwrite: true ],
                ]
            }

            // =================================================================
            // Alignments — not published
            // =================================================================

            withName: 'pbmm2_align_failedOnly' {
                cpus   = 32
                memory = '32 GB'
                time   = '24h'
                publishDir = [ enabled: false ]
            }

            withName: 'pbmm2_align_hifi' {
                cpus   = 64
                memory = '64 GB'
                time   = '72h'
            }

            // =================================================================
            // Bookkeeping — nothing published; inputs.tsv records the inputs
            // =================================================================

            withName: 'create_fofn' {
                executor   = 'local'
                cpus       = 2
                memory     = '4 GB'
                scratch    = false
                publishDir = [ enabled: false ]
            }

            withName: 'inputFiles_symlinks_ubam' {
                executor   = 'local'
                cpus       = 2
                memory     = '4 GB'
                scratch    = false
                publishDir = [ enabled: false ]
            }
        }
    }
}
