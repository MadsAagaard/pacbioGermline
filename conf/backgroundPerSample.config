/*
 * =============================================================================
 * conf/backgroundPerSample.config  —  'background' profile
 * =============================================================================
 *
 * Wire it in ONCE, as the LAST line of the repo's root nextflow.config:
 *
 *     includeConfig 'conf/backgroundPerSample.config'
 *
 * Then run:
 *
 *     nextflow run MadsAagaard/pacbioGermline -r refactor \
 *         -main-script backgroundPerSample.nf \
 *         -profile slurm,background \
 *         --bgSheet <metadata.txt>
 *
 * No -c needed. -c resolves against the launch directory, not the cloned asset,
 * which is why "conf/backgroundPerSample.config" was not found — a profile
 * travels with -r instead.
 *
 * Note: -main-script, ONE dash. Two dashes makes it a pipeline parameter named
 * 'main-script', which is ignored, and main.nf runs instead.
 *
 * -------------------------------------------------------------------------
 * WHY THE FILE IS SPLIT IN TWO
 * -------------------------------------------------------------------------
 * TOP LEVEL (always in effect, including clinical runs):
 *   inert params only — defaults and derived strings. They are unused by
 *   main.nf, and evaluating them here means they see command-line overrides
 *   (--bgRoot, --batch), because CLI params are visible during config parsing.
 *
 * INSIDE profiles.background (only when -profile background is active):
 *   everything that would break a clinical run — the outBase/lrsStorage
 *   redirect, publishDir replacement, workDir, reports, errorStrategy.
 *
 * Derived values are deliberately NOT computed inside the profile block: a
 * dotted assignment there writes into the profile's own scope, and reading it
 * back in a later statement of the same block is not reliable. Anything that
 * must be readable during parsing lives at top level; anything evaluated per
 * task is written as a closure.
 * =============================================================================
 */


// =============================================================================
// TOP LEVEL — inert params, safe for every run
// =============================================================================

params {

    // ---- Pool location -----------------------------------------------------
    // Declared rather than required on the command line, on purpose. There is
    // only one pool, so there is nothing to decide per run — and a typo'd
    // --bgRoot does not error: skip-if-done looks in the empty wrong place,
    // finds nothing, and realigns the entire cohort into a second pool nobody
    // knows about. The way to not typo a path is to not type it.
    bgRoot = '/lnx01_data3/storage/pacBioLRS/background'

    // ---- Required on the command line --------------------------------------
    bgSheet = null

    // ---- Optional ----------------------------------------------------------
    force    = false   // re-run samples already in the pool
    initPool = false   // permit creating a pool that does not exist
    batch    = null    // label for this run's reports
}

// Derived here, not inside the profile: these must resolve during parsing, and
// referencing params.X (map access, not a bare name) picks up CLI overrides.

// The flat pool: one directory per catalog, every sample together. What the LPS
// toolkit reads.
params.bgPool = "${params.bgRoot}/repeatExpansions/background"

// Names runInfo/ and the log header only. NOT a cohort version — the
// yymmdd+letter stamp is applied downstream, to a hand-picked subset.
params.batchTag = params.batch ?: new Date().format('yyMMdd_HHmmss')


// =============================================================================
// PROFILE — only active with -profile background
// =============================================================================

profiles {

    background {

        // ---------------------------------------------------------------------
        // OUTPUT REDIRECTION
        // ---------------------------------------------------------------------
        // The publishDir overrides further down are what actually place the
        // output. These are a safety net for anything else in the DAG that
        // publishes, and they are what backgroundPerSample.nf probes at startup
        // to prove the profile is active.
        //
        // _unused* is named to be conspicuous: a background run should write
        // nothing there. If files appear, a process publishDir was not
        // overridden (or config publishDir appends rather than replaces), and it
        // is immediately visible instead of silently duplicating the pool.
        //
        // The clinical 'auto' layout would interpolate nulls into
        // "null_null_<npn>_null_AllAndHifi" for a background meta, which carries
        // no rekv/testlist/groupKey — a malformed path rather than an error.
        // Overriding the closure removes the possibility.
        params.outBase       = { meta -> "${params.bgRoot}/_unusedPerSample/${meta.id}" }
        params.lrsStorage    = "${params.bgRoot}/_unusedStorage"
        params.outputDirBase = "${params.bgRoot}"
        params.multiqcKey    = { meta -> meta.id }

        // ---------------------------------------------------------------------
        // WORK DIRECTORY
        // ---------------------------------------------------------------------
        // The slurm profile derives workDir from ssBaseName, which is
        // 'NoSampleSheet' here, so two concurrent batches would collide.
        //
        // PROFILE ORDER MATTERS: -profile slurm,background puts this last, so it
        // wins. Reversing to background,slurm would give the slurm value.
        // Verify with: nextflow config . -profile slurm,background | grep workDir
        //
        // This is where the ~90 GB/sample alignments live. Run in batches of
        // 20-40 and clean between them:  nextflow clean -f -before <runName>
        workDir = "/nfs_fast_b/data/nextflowSlurmWork/${System.getenv('USER') ?: 'unknown'}/bg_${params.batchTag}"

        // ---------------------------------------------------------------------
        // REPORTING
        // ---------------------------------------------------------------------
        // nextflowLRS.config keys these on ${outputDirBase}/runInfo/<date>_<ssBase>.
        // ssBase is 'NoSampleSheet' here, so concurrent batches would collide.
        timeline { enabled = true; file = "${params.bgRoot}/runInfo/${params.batchTag}/timeline.html"; overwrite = true }
        report   { enabled = true; file = "${params.bgRoot}/runInfo/${params.batchTag}/report.html";   overwrite = true }
        dag      { enabled = true; file = "${params.bgRoot}/runInfo/${params.batchTag}/dag.html";      overwrite = true }
        trace {
            enabled   = true
            file      = "${params.bgRoot}/runInfo/${params.batchTag}/trace.txt"
            overwrite = true
            fields    = 'task_id,hash,name,tag,status,exit,attempt,realtime,%cpu,peak_rss,read_bytes,write_bytes,workdir'
        }

        // ---------------------------------------------------------------------
        // PROCESS
        // ---------------------------------------------------------------------
        process {

            // nextflowLRS.config computes defaultErrorStrategy from
            // params.errorMode at parse time, so setting params.errorMode here
            // would arrive too late to affect the resolved directive. Set the
            // directive itself.
            //
            // 'ignore' is safe because the pool is a set of independent
            // per-sample artifacts: a failed sample is simply absent, shows in
            // inputs.tsv as not having produced output, and is picked up by
            // re-running or -resume.
            errorStrategy = { task.attempt <= 2 && task.exitStatus in [104,130,134,137,138,139,140,143,247,250,251] ? 'retry' : 'ignore' }
            maxRetries    = 2

            // =================================================================
            // TRGT v5 — flat pool output
            // =================================================================
            // Setting publishDir in config supersedes the directive in the
            // process body, so this REPLACES all three publishDir blocks in
            // trgt5_all_adotto — both the clinical per-sample one and the two
            // lrsStorage ones. dnaModules.nf is not touched.
            //
            // VERIFY ON THE FIRST RUN: if ${bgRoot}/_unusedPerSample/ contains
            // anything afterwards, config publishDir appended rather than
            // replaced. Nothing lands outside bgRoot either way, so the failure
            // mode is duplicate files in an obviously-named directory.
            //
            // Patterns are catalog-specific rather than generic *.sorted.vcf.*,
            // so adotto and trexplorer output cannot land in each other's
            // directory:
            //   <npn>.<genome>.<strTag>.trgt5.adotto.sorted.vcf.gz{,.tbi}
            //   <npn>.<genome>.<strTag>.trgt5.adotto.LPS.txt
            //
            // No spanning-BAM entry: both processes run --disable-bam-output.
            //
            // Resources override the process 'intermediate' label. TRGT v5 is
            // threaded (--threads ${task.cpus}), so cpus is a real knob — tune
            // against the first batch's trace.txt rather than assuming.

            withName: 'trgt5_all_adotto' {
                cpus   = 32
                memory = '48 GB'
                time   = '72h'
                publishDir = [
                    [ path: { "${params.bgPool}/adotto" },
                      mode: 'copy', pattern: '*.trgt5.adotto.sorted.vcf.*', overwrite: true ],
                    [ path: { "${params.bgPool}/adotto_LPS" },
                      mode: 'copy', pattern: '*.trgt5.adotto.LPS.txt', overwrite: true ],
                ]
            }

            withName: 'trgt5_all_TRexplorer' {
                cpus   = 32
                memory = '48 GB'
                time   = '72h'
                publishDir = [
                    [ path: { "${params.bgPool}/trexplorer" },
                      mode: 'copy', pattern: '*.trgt5.trexplorer.sorted.vcf.*', overwrite: true ],
                    [ path: { "${params.bgPool}/trexplorer_LPS" },
                      mode: 'copy', pattern: '*.trgt5.trexplorer.LPS.txt', overwrite: true ],
                ]
            }

            // =================================================================
            // Alignments — not published
            // =================================================================
            // ~700 samples x ~90 GB of HiFi BAM is not storable, and nothing
            // downstream needs the alignment once both catalogs have read it.
            //
            // CONSEQUENCE: a third catalog later means realigning the whole
            // pool. Add it to the workflow BEFORE populating the pool.

            withName: 'pbmm2_align_failedOnly' {
                cpus   = 32
                memory = '32 GB'
                time   = '24h'
                publishDir = [ enabled: false ]
            }

            withName: 'pbmm2_align_hifi' {
                cpus   = 64
                memory = '64 GB'
                time   = '72h'
            }

            // =================================================================
            // Bookkeeping — nothing published; inputs.tsv records the inputs
            // =================================================================

            withName: 'create_fofn' {
                executor   = 'local'
                cpus       = 2
                memory     = '4 GB'
                scratch    = false
                publishDir = [ enabled: false ]
            }

            withName: 'inputFiles_symlinks_ubam' {
                executor   = 'local'
                cpus       = 2
                memory     = '4 GB'
                scratch    = false
                publishDir = [ enabled: false ]
            }
        }
    }
}