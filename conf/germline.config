/*
 * =============================================================================
 * pacbioGermline/conf/germline.config — pipeline config (between lrsShared.config and finalize.config)
 * Germline-only params, output layout and process overrides.
 * Shared values come from lrsShared.config.
 * =============================================================================
 * Carved out of nextflowLRS_refactor_v1.config without changing a value, except
 * where marked CHANGED. Names are the germline names (canonical) except
 * gencodeGtf -> gencodeV36Gtf (see lrsShared.config, section 5).
 * =============================================================================
 */

// =============================================================================
// 1. GERMLINE CLI FLAGS
// =============================================================================
params {

    // ---- Run mode -----------------------------------------------------------
    summary             = null

    // ---- Input --------------------------------------------------------------
    aligned             = null   // REMOVED — main.nf errors if this is set
    customSS            = null   // 3- or 5-column manual samplesheet
    jointSS             = null   // 7-field single-column LabWare metadata samplesheet
    singleOnly          = null
    intrefOnly          = null

    // ---- Read set selection (default: HiFi + fail, aligned separately) ------
    failedReads         = null   // fail reads only (debug/QC use)
    allReads            = null   // DEPRECATED: pre-refactor merged-BAM mode

    // ---- Skips --------------------------------------------------------------
    skipQC              = null
    skipVariants        = null
    skipSV              = null
    skipSTR             = null

    // ---- Joint calling / prioritisation -------------------------------------
    jointCall           = null
    hpo                 = null
    groupedOutput       = null

    // ---- Family analysis (pacbio_familyAnalysis_v3.sh) ----------------------
    familySS            = null
    familyDir           = null
    familyJSON          = null
    gvcfManifest        = null
    sawfishCSV          = null
    caseID              = null

    // ---- Output layout ------------------------------------------------------
    outputLayout        = null

    // ---- Execution ----------------------------------------------------------
    createSymlinks      = false

    // ---- Minimum input size gates ------------------------------------------
    minHifiGB           = 34
    minFailGB           = 4
    minGB               = null   // legacy alias; if set, overrides minHifiGB

    // ---- uBAM archive -------------------------------------------------------
    dataArchive         = "${params.dataArchiveRoot}/rawData/"

    // ---- Containers ---------------------------------------------------------
    // CHANGED (mechanism only): was a fixed deepvariantSif = deepvariant190.sif.
    // Same image by default; --deepvariant now selects another.
    deepvariantDefault  = 'v190'
}


// =============================================================================
// 2. DERIVED RUN CONTEXT  (unchanged)
// =============================================================================
def readSetSuffix =
      params.failedReads ? 'failedReadsOnly'
    : params.hifiReads   ? 'hifiReads'
    : 'AllAndHifi'

def inputReadSetTag =
      params.failedReads ? 'failedReadsOnly'
    : params.hifiReads   ? 'HifiReads'
    : 'HifiAndFail'

def strTagValue =
      params.failedReads ? 'failedReadsOnly'
    : params.hifiReads   ? 'HifiReadsOnly'
    : 'AllReadsNew'

// Germline keeps its own fallback to the family sheet; only '.txt' is stripped,
// as before (finalize.config would also strip '.csv').
def ssBaseName = params.samplesheet
    ? params.samplesheet.toString().tokenize('/').last().replaceFirst(/\.txt$/, '')
    : params.familySS
        ? params.familySS.toString().tokenize('/').last().replaceFirst(/\.txt$/, '')
        : 'NoSampleSheet'

def outDirBase = params.familyDir
    ? params.familyDir
    : params.outdir
        ? "${params.outdir}_${readSetSuffix}"
        : "/lnx01_data3/pacBioAnalyzedSamples/${params.genome}/${params.yearStamp}/"

params {
    readSet         = readSetSuffix       // 'AllAndHifi' | 'hifiReads' | 'failedReadsOnly'
    inputReadSet    = inputReadSetTag
    ssBase          = ssBaseName
    outputDirBase   = outDirBase
    toolsVersion    = params.latestVersions ? '_latestToolVersions' : ''
    tagHifi         = 'HifiReads'
    tagFail         = 'failedReads'
    strTag          = strTagValue
    lrsStorage      = "${params.lrsStorageRoot}/${params.genome}/${readSetSuffix}"
}

params.minHifiGBeff = params.minGB ?: params.minHifiGB


// =============================================================================
// 3. OUTPUT LAYOUT  (unchanged)
// =============================================================================
if (params.intrefOnly) params.outputLayout = 'intRefSingles'
if (params.singleOnly) params.outputLayout = 'singleSample'

params.layoutMode = params.outputLayout ?: (
    params.familyDir  ? 'jointAnalysis'     :
    params.jointSS    ? 'jointAnalysis'     :
    params.customSS   ? 'CustomSampleSheet' :
    'auto'
)

params.outBase = { meta ->
    def base = params.outputDirBase
    def rs   = params.readSet
    def tv   = params.toolsVersion

    switch (params.layoutMode) {

        case 'jointAnalysis':
            return "${base}/jointAnalysis/${meta.caseID}_${rs}${tv}"

        case 'CustomSampleSheet':
            return "${base}/customSampleSheetAnalysis/${meta.caseID}/${meta.id}_${rs}${tv}"

        case 'auto':
            def sub = (meta.groupKey == 'single') ? 'singleSamples' : 'intRefSamples'
            return "${base}/perSampleAnalysis/${sub}/${meta.rekv}_${meta.testlist}_${meta.id}_${meta.groupKey}_${rs}${tv}"

        case 'singleSample':
            return "${base}/perSampleAnalysis/singleSamples/${meta.rekv}_${meta.testlist}_${meta.id}_${meta.groupKey}_${rs}${tv}"

        case 'intRefSingles':
            return "${base}/perSampleAnalysis/intRefSamples/${meta.rekv}_${meta.testlist}_${meta.id}_${meta.groupKey}_${rs}${tv}"

        default:
            throw new IllegalArgumentException("Unknown layoutMode='${params.layoutMode}'")
    }
}

params.multiqcKey = { meta ->
    (params.layoutMode == 'jointAnalysis') ? meta.caseID : meta.id
}


// =============================================================================
// 4. SEX / KARYOTYPE closures (kept for any module still calling them;
//    modules/lrsFunctions.nf karyotypeFlag / expectedCnFlag are preferred)
// =============================================================================
params.karyotype = { meta ->
    if (meta.sex == 'male')   return '--karyotype XY'
    if (meta.sex == 'female') return '--karyotype XX'
    throw new IllegalStateException(
        "Sample '${meta.id}': meta.sex='${meta.sex}'. Sex should have been validated " +
        "at samplesheet parse time — refusing to guess a karyotype.")
}

params.sawfishExpectedCn = { meta ->
    if (meta.sex == 'male')   return "--expected-cn ${params.sawfishExpectedCnXY}"
    if (meta.sex == 'female') return "--expected-cn ${params.sawfishExpectedCnXX}"
    throw new IllegalStateException(
        "Sample '${meta.id}': meta.sex='${meta.sex}' — refusing to guess expected copy number.")
}


// =============================================================================
// 5. GERMLINE-ONLY PROGRAMS, SCRIPTS AND CONFIG FILES
// =============================================================================
params {
    pharmcatJar         = "${params.programPath}/pharmcat32/pharmcat-3.2.0-all.jar"
    kivviDir            = '/data/shared/programmer/kivvi-v1.0.0'
    trgtLps             = '/data/shared/programmer/BIN/trgt-lps-v0.10.0'

    germlineSummaryPy   = "${params.lrsCustomToolsBase}/summaryScripts/germlineDNA/germline_dna_summary.py"
    germlineSummaryHtml = "${params.lrsCustomToolsBase}/summaryScripts/germlineDNA/germline_dna_summary_report_template.html"
    // CHANGED: leading '/' removed (was "//data/..."; same file)
    mirrorSampleData    = "${params.lrsCustomToolsBase}/helperScripts/pacbio.mirrorSampleData.sh"
    germlineQcThresholds = "${params.helperScripts}/germline/kgvejle_lrs_germline_thresholds.yaml"

    exomiserExomeYml    = "${params.programPath}/configfiles/exomiser/exo14.exomeAnalysis.v1.yaml"
    exomiserGenomeYml   = "${params.programPath}/configfiles/exomiser/exo14.genomeAnalysis.v1.yaml"
    exomiserProperties  = "${params.programPath}/exomiser-cli-14.1.0/application.properties"
    exomiserJar         = "${params.programPath}/exomiser-cli-14.1.0/exomiser-cli-14.1.0.jar"
    exomiserSpringDir   = "${params.programPath}/exomiser-cli-14.1.0/"
}


// =============================================================================
// 6. GERMLINE-ONLY CONDA ENVS (merged into params.condaEnvs from lrsShared.config)
// =============================================================================
params {
    condaEnvs {
        glnexus           = "${params.condaLocal}/glnexus/"
        svtopo            = "${params.condaLocal}/svtopo/"
        mitorsaw          = "${params.condaLocal}/mitorsaw/"
        starphase         = "${params.condaLocal}/starphase/"
        paraphase40       = "${params.condaLocal}/paraphase40/"
        paraphaseMinimap2 = "${params.condaLocal}/paraphaseMinimap2/"
        nanostats         = "${params.condaLocal}/nanostats/"
        hifiasm           = "${params.condaLocal}/hifiasm/"
    }
}


// =============================================================================
// 7. PROCESS OVERRIDES — slurm (merge with the base slurm profile)
// =============================================================================
profiles {
    slurm {
        process {
            withName: 'hiPhaseTwoAln' {
                errorStrategy = 'retry'
                maxRetries    = 1
                scratch       = { task.attempt == 1 }
                time          = { task.attempt == 1 ? '48.h'  : '72.h' }
                memory        = { task.attempt == 1 ? '32.GB' : '64.GB' }
            }

            withName: 'paraphase4' {
                errorStrategy = 'retry'
                maxRetries    = 1
                scratch       = { task.attempt == 1 }
                time          = { task.attempt == 1 ? '48.h'  : '72.h' }
                memory        = { task.attempt == 1 ? '32.GB' : '64.GB' }
            }

            withName: 'pbmm2_align_failedOnly' {
                cpus   = 32
                memory = '32 GB'
                time   = '24h'
            }

            withName: 'pbmm2_align_hifi' {
                cpus   = 64
                memory = '64 GB'
                time   = '72h'
            }

            withName: 'trgt5_all_adotto|trgt5_all_TRexplorer' {
                cpus   = 32
                memory = '48 GB'
                time   = '72h'
            }

            // GLNexus inflates gVCFs into RocksDB on node-local scratch (700-900 GB per shard).
            withName: 'glNexus_jointCall' {
                cpus   = 32
                memory = '64 GB'
                time   = '72h'
            }
        }
    }
}
