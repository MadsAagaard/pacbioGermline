/*
 * pacbioGermline — entry config
 * Run:  nextflow run MadsAagaard/pacbioGermline -r <tag> -profile slurm --samplesheet <sheet>
 *
 * Layers (same order in all four LRS pipelines):
 *   lrsShared.config -> conf/germline.config -> finalize.config
 */

params {
    genome        = 'hg38'
    rundir        = "${launchDir.baseName}"

    // Shared layer: a locally managed, versioned folder on the server.
    // Pinned per pipeline. Move this pipeline to a new version deliberately,
    // after its own validation run; test one first with
    //   --lrsSharedDir /data/configs/lrsShared/v<next>
    lrsSharedDir       = '/data/configs/lrsShared/v1'

    // lrsCustomTools release (scripts, report templates, PTCP resources).
    // null = releases/current, resolved at launch. Pin a release for clinical runs:
    //   '/data/mmaj/scripts_local/lrsCustomTools/releases/<yymmdd>_main_<sha>'
    lrsCustomToolsBase = null
}

def supportedGenomes = ['hg38', 't2t']

if (!(params.genome in supportedGenomes)) {
    throw new IllegalArgumentException(
        "Unknown --genome '${params.genome}'. Supported by pacbioGermline: ${supportedGenomes.join(', ')}")
}

def sharedConf = { String name ->
    def f = new File("${params.lrsSharedDir}/${name}")
    if (!f.exists()) {
        throw new IllegalStateException("Shared config not found: ${f}")
    }
    return f
}

includeConfig sharedConf('lrsShared.config')
includeConfig 'conf/germline.config'
includeConfig sharedConf('finalize.config')     // always last

includeConfig 'conf/backgroundPerSample.config'     // -profile background only
