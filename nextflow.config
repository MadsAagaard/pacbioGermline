params {
    rundir = "${launchDir.baseName}"
    genome = 'hg38'          // overridden by --genome
}

def sharedConfigs = [
    hg38 : '/data/configs/nextflowLRS_refactor_v1.config',
    t2t  : '/data/configs/nextflowLRS_T2T.config',
]

def sharedConfigPath = sharedConfigs[ params.genome ]

if (!sharedConfigPath) {
    throw new IllegalArgumentException(
        "Unknown --genome '${params.genome}'. Supported: ${sharedConfigs.keySet().join(', ')}")
}

if (!new File(sharedConfigPath).exists()) {
    throw new IllegalStateException(
        "Shared config for --genome ${params.genome} not found at ${sharedConfigPath}")
}

includeConfig sharedConfigPath
